{
  "name": "@watchletic/cli",
  "version": "0.2.2",
  "description": "Official CLI for the Watchletic Data API",
  "type": "module",
  "bin": {
    "watchletic": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/watchletic/cli.git"
  },
  "homepage": "https://github.com/watchletic/cli#readme",
  "bugs": {
    "url": "https://github.com/watchletic/cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "generate": "openapi-typescript ../watchletic-api/openapi/watchletic-v1.yaml -o src/generated/schema.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run test && npm run typecheck && npm run build"
  },
  "keywords": [
    "watchletic",
    "fitness",
    "workouts"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "14.0.0",
    "openapi-fetch": "0.14.0",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/proper-lockfile": "4.1.4",
    "openapi-typescript": "7.9.1",
    "tsup": "8.5.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.7"
  }
}
